#!/bin/sh
set -eu
mkdir -p /root/xmtr-vm/tmp /root/xmtr-vm/default-feeds
export TMPDIR=/root/xmtr-vm/tmp
{% if case.format == 'ipk' %}
{% set autoremove = ' --autoremove' if vm.get('luci_autoremove', 'true') == 'true' else '' %}
for package in \
{{ vm.luci_packages_lines | indent(4, true) }}; do
    opkg --tmp-dir "$TMPDIR" --noaction remove{{ autoremove }} "$package"
    opkg --tmp-dir "$TMPDIR" remove{{ autoremove }} "$package"
done
{% if vm.web_packages %}
opkg --tmp-dir "$TMPDIR" remove {{ vm.web_packages }}
{% endif %}
opkg list-installed > /root/xmtr-vm/packages-after.txt
test -z "$(opkg list-installed 'luci*')"
for source in /etc/opkg/*.conf; do
    [ ! -f "$source" ] || mv "$source" /root/xmtr-vm/default-feeds/
done
{% else %}
{% if vm.remove_packages %}
apk --no-network del {{ vm.remove_packages }}
{% endif %}
apk info --from installed > /root/xmtr-vm/packages-after.txt
if apk info --from installed --exists luci-base; then
    exit 1
else
    test "$?" -eq 1
fi
{% endif %}
set -- {{ vm.web_executables }}
for executable do
    test ! -x "$executable"
done
test -x /sbin/netifd
test -x /usr/sbin/dnsmasq
test -x /sbin/ubusd
uci set network.lan.proto='dhcp'
uci set network.lan.ip6assign='0'
uci commit network
uci set dhcp.lan.ignore='1'
uci commit dhcp
/etc/init.d/network reload
/etc/init.d/dnsmasq restart
attempt=0
until ip -4 route show default | grep -Fq '10.0.2.2'; do
    attempt=$((attempt + 1))
    test "$attempt" -lt 30
    sleep 1
done
attempt=0
until nslookup downloads.openwrt.org > /root/xmtr-vm/dns.txt 2>&1; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 30 ]; then
        cat /root/xmtr-vm/dns.txt
        exit 1
    fi
    sleep 1
done
{
    ip -4 addr show
    ip -4 route
    ping -c 1 -W 3 127.0.0.1
    cat /root/xmtr-vm/dns.txt
} > /root/xmtr-vm/network.txt
